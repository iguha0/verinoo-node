    "expected": "{\"data\":{\"data\":{},\"type\":\"transfer\"},\"from\":\"ai_a\",\"nonce\":7,\"to\":\"ai_b\",\"value\":10}"
  },
  {
    "name": "unicode_and_escapes",
    "input": {
      "k": "quote\" back\\slash\nnewline ünïcode ✓"
