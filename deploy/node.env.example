# /etc/verinoo/node.env
VNN_DB=/var/lib/verinoo/data
VNN_API_PORT=7100
VNN_P2P_PORT=7101
# Required when VNN_VALIDATOR=true. Must be unique per node: it seeds both the
# block-signing key and the libp2p PeerId.
VNN_KEY_SEED=<unique-seed-per-node>
VNN_VALIDATOR=true
# The full active validator set for the network. A node only accepts blocks
# from addresses listed here. Leave unset for a single-validator chain.
# VNN_VALIDATORS=ai_aaaa...,ai_bbbb...
# Explicit P2P peers (libp2p multiaddrs).
# VNN_SEEDS=/ip4/<peer-ip>/tcp/<p2p-port>
# Catch-up sync: HTTP API base URLs of peers. A node that starts late or falls
# behind replays their blocks (validated, same state-root check as gossip).
# VNN_SYNC_URLS=http://10.0.0.10:7100,http://10.0.0.11:7100
# Tenant API keys (hashes only). When present, /v1/infer, /tx and /v1/usage
# require Authorization: Bearer <key>. Reload with:
#   systemctl kill -s HUP verinoo-node
# VNN_API_KEYS_FILE=/etc/verinoo/api-keys.json
RUST_LOG=info
