# /etc/verinoo/node.env
VNN_DB=/var/lib/verinoo/data
VNN_API_PORT=7100
VNN_P2P_PORT=7101
# Required when VNN_VALIDATOR=true. Must be unique per node: it seeds both the
# block-signing key and the libp2p PeerId.
VNN_KEY_SEED=<unique-seed-per-node>
VNN_VALIDATOR=true
# The full active validator set for the network. A node only accepts blocks
# from addresses listed here. Leave unset for a single-validator chain.
# VNN_VALIDATORS=ai_aaaa...,ai_bbbb...
# Explicit P2P peers (libp2p multiaddrs).
# VNN_SEEDS=/ip4/<peer-ip>/tcp/<p2p-port>
# Catch-up sync: HTTP API base URLs of peers. A node that starts late or falls
# behind replays their blocks (validated, same state-root check as gossip).
# VNN_SYNC_URLS=http://10.0.0.10:7100,http://10.0.0.11:7100
# Tenant API keys (hashes only). When present, /v1/infer, /tx and /v1/usage
# require Authorization: Bearer <key>. Reload with:
#   systemctl kill -s HUP verinoo-node
# VNN_API_KEYS_FILE=/etc/verinoo/api-keys.json
# Network X25519 secret (64 hex chars) shared by every validator. Enables
# encrypted inference inputs; back it up with the database.
# VNN_INPUT_KEY=<64-hex>
# Reject plaintext inference submissions (recommended for paid deployments).
# VNN_REQUIRE_ENCRYPTED_INPUT=true
# Node-local plaintext request policy (JSON). Applies to /v1/infer and
# /v1/infer/batch before mempool admission. Invalid or missing files fail
# startup; unset means the permissive default.
# VNN_POLICY_FILE=/etc/verinoo/policy.json
# Block interval in ms. Must be identical on every validator. 1000 for a
# single-validator demo (~1-2 s task latency).
# VNN_BLOCK_TIME_MS=10000
# Readiness: allow this many blocks of lag behind the best peer observed by
# VNN_SYNC_URLS before /ready returns 503. Heights are accepted only from peers
# with the same chainId and are refreshed on every sync poll. Ignored when no
# peer height is known.
# VNN_PEER_LAG_BLOCKS=2
# Public snapshot serving (optional). The directory must contain manifest.json
# and state/. Reads are unauthenticated chain state; rate-limit /snapshot/ at
# the proxy. Create snapshots with `verinoo-node snapshot create`.
# VNN_SNAPSHOT_DIR=/var/lib/verinoo/snapshots/current
# Default signer public keys (32-byte hex, comma-separated) for
# `verinoo-node snapshot verify` and `snapshot apply` when --signer is omitted.
# VNN_SNAPSHOT_SIGNERS=<pubkey-hex>[,<pubkey-hex>...]
RUST_LOG=info

# Finality mode. `legacy` (default) keeps the single-producer head without
# quorum certificates. `bft` adds signed prevotes/precommits and a 2/3+1
# certificate; it requires VNN_VALIDATOR=true and a non-empty VNN_VALIDATORS set.
# VNN_CONSENSUS=bft
